{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Notes",
  "version": "0.1.0",
  "identifier": "com.voicenotes.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../voice-notes-frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../voice-notes-frontend run build",
    "frontendDist": "../../voice-notes-frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Voice Notes",
        "width": 760,
        "height": 720,
        "minWidth": 420,
        "minHeight": 520,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
