# Copy to .env and fill in. Never commit .env.
DEEPGRAM_API_KEY=
GROQ_API_KEY=
# Neon gives: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
DATABASE_URL=
# Any long random string; signs JWTs.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional
# GROQ_MODEL=qwen/qwen3.8-27b
# ACCESS_TOKEN_MINUTES=30
# REFRESH_TOKEN_DAYS=30
# RESET_TOKEN_MINUTES=30

# Email for password resets. Default "console" prints the message (and the
# reset link) in the backend log. For real delivery set EMAIL_BACKEND=smtp.
# EMAIL_BACKEND=console
# EMAIL_FROM=Voice Notes <noreply@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls        # starttls | ssl | none
# Reset links point here; must be the URL the browser uses for the frontend.
# FRONTEND_URL=http://localhost:5173

# Logging: LOG_LEVEL=DEBUG|INFO|WARNING, LOG_FORMAT=text|json (json for prod log shippers)
# LOG_LEVEL=INFO
# LOG_FORMAT=text

# Browser origins allowed to call the API, comma-separated. Set to the deployed
# frontend URL in production (e.g. https://notes.example.com).
# CORS_ORIGINS=http://localhost:5173
# Set true only behind a reverse proxy that sets X-Forwarded-For.
# TRUST_PROXY_HEADERS=false

# Shared rate-limit state. Leave unset for one worker (in-process counters).
# Required for several workers/instances or every one allows the full limit.
# REDIS_URL=redis://localhost:6379/0
# If Redis is unreachable: true = let requests through (log), false = 429.
# RATE_LIMIT_FAIL_OPEN=true

# Abuse / cost caps (defaults shown)
# MAX_TRANSCRIPT_CHARS=20000
# MAX_DICTATION_SECONDS=600
# MAX_STREAMS_PER_USER=2
# RATE_AUTH_PER_MIN=10
# RATE_RESET_PER_MIN=3
# RATE_LLM_PER_MIN=20
# RATE_STREAMS_PER_MIN=10
