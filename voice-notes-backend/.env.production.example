# Production template. Copy to .env on the server (or set these as platform
# environment variables) and fill in. Never commit the filled-in file.

# --- Required ---------------------------------------------------------------
DEEPGRAM_API_KEY=
GROQ_API_KEY=
# Neon: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
DATABASE_URL=
# Fresh random value for production; rotating it logs every user out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Must change for production --------------------------------------------
# The deployed frontend origin(s), comma-separated, scheme included, no path.
CORS_ORIGINS=https://notes.example.com
# JSON lines for your log shipper.
LOG_FORMAT=json
LOG_LEVEL=INFO
# true ONLY if a reverse proxy / load balancer you control sits in front and
# sets X-Forwarded-For. The Docker entrypoint also enables uvicorn's
# --proxy-headers when this is true.
TRUST_PROXY_HEADERS=false

# --- Tune to taste -----------------------------------------------------------
# GROQ_MODEL=qwen/qwen3.8-27b
# JWT_EXPIRE_DAYS=7
# MAX_TRANSCRIPT_CHARS=20000
# MAX_DICTATION_SECONDS=600
# MAX_STREAMS_PER_USER=2
# RATE_AUTH_PER_MIN=10
# RATE_LLM_PER_MIN=20
# RATE_STREAMS_PER_MIN=10

# --- Container runtime (read by docker-entrypoint.sh, not the app) ----------
# PORT=8000
# Keep at 1 unless rate limits move to Redis: the limiters are per process.
# WEB_CONCURRENCY=1
