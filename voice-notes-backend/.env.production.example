# Production template. Copy to .env on the server (or set these as platform
# environment variables) and fill in. Never commit the filled-in file.

# --- Required ---------------------------------------------------------------
DEEPGRAM_API_KEY=
GROQ_API_KEY=
# Neon: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
DATABASE_URL=
# Fresh random value for production; rotating it logs every user out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Must change for production --------------------------------------------
# The deployed frontend origin(s), comma-separated, scheme included, no path.
CORS_ORIGINS=https://notes.example.com
# JSON lines for your log shipper.
LOG_FORMAT=json
LOG_LEVEL=INFO
# true ONLY if a reverse proxy / load balancer you control sits in front and
# sets X-Forwarded-For. The Docker entrypoint also enables uvicorn's
# --proxy-headers when this is true.
TRUST_PROXY_HEADERS=false

# Password-reset email. Use your provider's SMTP relay (SendGrid, Postmark,
# SES, Mailgun, ... all offer one). Port 587 + starttls is the usual pairing;
# 465 + ssl also works.
EMAIL_BACKEND=smtp
EMAIL_FROM=Voice Notes <noreply@your-domain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
# The frontend origin, used to build reset links.
FRONTEND_URL=https://notes.example.com

# --- Tune to taste -----------------------------------------------------------
# GROQ_MODEL=qwen/qwen3.8-27b
# ACCESS_TOKEN_MINUTES=30
# REFRESH_TOKEN_DAYS=30
# MAX_TRANSCRIPT_CHARS=20000
# MAX_DICTATION_SECONDS=600
# MAX_STREAMS_PER_USER=2
# RATE_AUTH_PER_MIN=10
# RATE_RESET_PER_MIN=3
# RATE_LLM_PER_MIN=20
# RATE_STREAMS_PER_MIN=10

# Shared rate-limit counters. Set this whenever WEB_CONCURRENCY > 1 or more
# than one instance runs; otherwise each process allows the full limit.
# Any managed Redis works (Upstash, Redis Cloud, ElastiCache, Fly Redis).
REDIS_URL=
RATE_LIMIT_FAIL_OPEN=true

# --- Container runtime (read by docker-entrypoint.sh, not the app) ----------
# PORT=8000
# Workers per container. >1 needs REDIS_URL above.
# WEB_CONCURRENCY=2
